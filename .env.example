# Public URL of your deployed BANTER application (include https://)
BETTER_AUTH_URL=http://localhost:8080

# Generate a unique 32+ character secret for production.
# Example: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Persistent PostgreSQL connection string (Neon or another PostgreSQL provider).
# Leave blank for local-only PGLite development; do not use PGLite in production.
DATABASE_URL=
